[node name="Taking Stock" parent="AvailableQuests" unique_id=1961663541 instance=ExtResource("2_7xuob")]
quest_id = 11
quest_name = "Taking Stock"
quest_description = "Knowing what's to come is more important yet than any power one can wield. To find weaknesses in the unholy defenses of our adversary one must be both creative and able to detect its dark influence and power. And don't dawdle long for unwanted attention may prove lethal.
"
quest_success_outcome = "Even the best armor has a weakness somewhere and now we are informed and able to formulate a plan to abuse just such a weak point. However, what was seen on this journey can never be unseen and the question of whether this is possible at all lays heavy on the mind
"
quest_neutral_outcome = "Still feeling watched, at the end of the day we feel no wiser than in the morrow. Another trip to the curse steeped streets feels daunting but the luxury of choice is not ours,
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 3
rewards_corruption_reduction = true
reward_corruption_reduction = 10.0

