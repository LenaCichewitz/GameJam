[node name="A stab to the heart" parent="AvailableQuests" unique_id=1200277134 instance=ExtResource("2_7xuob")]
quest_id = 13
quest_name = "A stab to the heart"
quest_description = "The most direct way to the goal is simple: just go straight into the core of the darkness.Facing the enemy on its terms seems almost laughable but there is value in doing the unexpected. We know not what expects us within the depths of darkness only that it will test us like nothing has before. Only one certain in the fact that they can overcome whatever may be thrown at them should brave these streams.
"
quest_neutral_outcome = "The colors, the sounds and the overpowering feeling of dread, the experience within the core was indescribable and horrific. Imagining what it takes to succeed in this hell seems impossible and a dread fills the air with every breath taken
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
is_final_quest = true
quest_group = 4

