[node name="Bread and Games" parent="AvailableQuests" unique_id=951889181 instance=ExtResource("2_7xuob")]
quest_id = 9
quest_name = "Bread and Games"
quest_description = "The old arena seems animated with magic. A powerful cursed object must bring this about and we minted to use it for our benefit. Once stepping into the veil of the spell there is no knowing what to expect so send someone who triumphs no matter the circumstances 
"
quest_success_outcome = "As the spell fizzles into the deep waters the coin now in our hands feels distinctly… alive. A power both great and dangerous. Amongst us a feeling of unease takes hold
"
quest_neutral_outcome = "Stepping out of the spell empty handed was expected, having no memory of the ordeal was not. Whatever magic animates the arena can only be of godly origin but refusing such power is simply not an option.
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 3
rewards_item = true
reward_item_id = 5

