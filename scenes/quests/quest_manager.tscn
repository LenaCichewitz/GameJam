[node name="Find Help" parent="AvailableQuests" unique_id=1488423929 instance=ExtResource("2_7xuob")]
quest_id = 1
quest_name = "Find Help"
quest_description = "The Clock is Ticking and we're gonna need all Hands on Deck if we wanna accomplish this in Time. Lady Edeltraut has connections everywhere, and more than a few favors to Cash in.
"
quest_success_outcome = "The only ones willing to assist us in this endeavor are others with the same affliction, but that's exactly who we need. They are currently busy keeping themselves sane but will come to our aid if need be. Beware tho as soon as they join us their time too is limited.
"
quest_neutral_outcome = "Try as she might, Mae just does not have it in her to play the Diplomatic games necessary to succeed here. A timeloss this early stings we have to Focus up!
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."

[node name="An Artifact of War" parent="AvailableQuests" unique_id=1706432302 instance=ExtResource("2_7xuob")]
quest_id = 2
quest_name = "An Artifact of War"
quest_description = "According to Mae there lies a powerful Kopisin the Streets of outer Atlantis, abandoned from a battle years ago. We don't know which Spirits will awaken once we pick it up so someone who thinks on their feet and is quick to act will need to step up
"
quest_success_outcome = "While the Kopis has certainly seen better times the Power emanating from it is still Palpable. With a little work it will be a powerful tool for us.
"
quest_neutral_outcome = "Once the Kopis was grasped a Host of Spirits sprung up. With fast thinking and actions just as swift we might have secured the relic but this time it had to be left behind to secure escape.
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 1
rewards_item = true
reward_item_id = 1

[node name="StatsToClear" parent="AvailableQuests/An Artifact of War" index="0" unique_id=329966221]
_agility = SubResource("Curve_lgvmb")
_map_layout_knowledge = SubResource("Curve_mxc5p")

[node name="Ancient Knowledge" parent="AvailableQuests" unique_id=1359076990 instance=ExtResource("2_7xuob")]
quest_id = 3
quest_name = "Ancient Knowledge"
quest_description = "We need to know our Enemy to even stand a chance. The sunken Library holds long lost knowledge that might just be what we need. Someone versed in the ancient rites will know just where to find what we need, though they may not like what will be found…
"
quest_success_outcome = "Ancient texts reveal the locations of powerful Artifacts deep in the city's bowls. Boons from the gods may yet but us on even footing with the enemy. While this knowledge is certain to aid us greatly it seems the trip has had a lasting effect.
"
quest_neutral_outcome = "Searching the library revealed much but nothing of use to us. A deeper knowledge of the ancient customs may be necessary to find exactly what we need.
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 1
rewards_corruption_reduction = true
reward_corruption_reduction = 10.0

[node name="StatsToClear" parent="AvailableQuests/Ancient Knowledge" index="0" unique_id=329966221]
_eldritch_knowledge = SubResource("Curve_qqstm")

[node name="A looming threat" parent="AvailableQuests" unique_id=1932161826 instance=ExtResource("2_7xuob")]
quest_id = 4
quest_name = "A looming threat"
quest_description = "To secure a path deeper into the city conflict will be unavoidable. An ancient guardian statue stands on the city's inner walls, ever on watch for intruders. The construct's age makes it vulnerable but the fight will be anything but trivial. 
"
quest_success_outcome = "A hard fought battle clears not only the path into the city but also the mind. Knowing these horrors can be beaten back lightens the burden of the curse ever so slightly.
"
quest_neutral_outcome = "Despite a valiant effort the guardian proves to be a steep wall to climb indeed. Precious time has been lost but no life was forfeit today. We must return with a more experienced fighter or better equipment
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 1
rewards_corruption_reduction = true
reward_corruption_reduction = -20.0

[node name="StatsToClear" parent="AvailableQuests/A looming threat" index="0" unique_id=329966221]
_combat = SubResource("Curve_tr7ox")

[node name="Combing the Fields" parent="AvailableQuests" unique_id=1664053837 instance=ExtResource("2_7xuob")]
quest_id = 5
quest_name = "Combing the Fields"
quest_description = "One of the artifacts is already in our possession but it remains uncompleted. A magic pearl from a mutated clam is required to power it and can be found on the outskirts of the city. Once a field for growing and harvesting clams it has since overgrown into a mass of seaweed and chaos. A scavenger hunt for a cursed creature certainly requires a specific set of skills.
"
quest_success_outcome = "Among the overflowing mass lay the abomination of a clam, its pearl now ours to harvest and put to good use.
"
quest_neutral_outcome = "Despite hours of looking, the clam evades us still. Perceptive eyes and a feeling for the otherworldly may yet help us locate it within the chaos
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 2
rewards_item = true
reward_item_id = 2

[node name="StatsToClear" parent="AvailableQuests/Combing the Fields" index="0" unique_id=329966221]
_awareness = SubResource("Curve_8up6o")
_eldritch_knowledge = SubResource("Curve_42d3x")

[node name="Winding ways #2" parent="AvailableQuests" unique_id=122931068 instance=ExtResource("2_7xuob")]
quest_id = 6
quest_name = "Winding ways"
quest_description = "The winding streets of the slums rival a maze in all its confusion. Within them lies one of the artifacts we are seeking. While a good eye is certainly of import, even more so is a capacity to withstand, as the slinging paths may drive anyone to madness.
"
quest_success_outcome = "Navigation these streets was difficult but fruitful, as the gods bounty is now ours to use against our foes, just as soon as it is restored
"
quest_neutral_outcome = "Returning from this hell at all is admirable, even empty handed as it is. We will need to brave it again however and this time nerves of steel and eyes like a sea-hawk must prevail. 
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 2
rewards_item = true
reward_item_id = 3

[node name="StatsToClear" parent="AvailableQuests/Winding ways #2" index="0" unique_id=329966221]
_awareness = SubResource("Curve_j63pw")
_mental_clarity = SubResource("Curve_8uk7a")

[node name="A grab for power" parent="AvailableQuests" unique_id=1521420106 instance=ExtResource("2_7xuob")]
quest_id = 7
quest_name = "A grab for power"
quest_description = "Alas hoping we were uncontested in our search for power was a short dream. A group of traveling trades have one of the Artifacts, though they seem not to know what they have on their hands. We must get in, take out the guards and get out before backup arrives. Prepare to get your hands dirty
"
quest_success_outcome = "With fresh blood on our hands and immense power in our possession the only thing left to do is restore the artefact and forget what lies behind us
"
quest_neutral_outcome = "A bloodied return is a return nonetheless. They seem not to know what it is we were searching for so we may yet have a shot. Speed and power are of utmost import if we are to attempt another attack
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 2
rewards_item = true
reward_item_id = 4

[node name="StatsToClear" parent="AvailableQuests/A grab for power" index="0" unique_id=329966221]
_agility = SubResource("Curve_7c7fg")
_combat = SubResource("Curve_lkrw4")

[node name="Deep dive" parent="AvailableQuests" unique_id=428837585 instance=ExtResource("2_7xuob")]
quest_id = 8
quest_name = "Deep dive"
quest_description = "Below the streets, in what was once the city's sewers, supposedly hides a scholar who once researched a cure to the curse. A conversation with him may prove invaluable. These tunnels are vast and unexplored. Spending too much time here will surely prove lethal so move quickly, think on your feet and be prepared to see things that might… unnerve a lesser mind.
"
quest_success_outcome = "Tho the scholar expired some moons ago his research notes are mostly intact. The only way to stop the curse, it seems, is to destroy its root deep in the core of the city. Knowing there is a way to rid yourself brings forth the energy to contain the curse and push onwards
"
quest_neutral_outcome = "What these tunnels contain can not be described and there is no shame in returning unsuccessful. Yet still we must brave these depths again in hopes of a way forward. 
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 2
rewards_corruption_reduction = true
reward_corruption_reduction = -50.0

[node name="StatsToClear" parent="AvailableQuests/Deep dive" index="0" unique_id=329966221]
_agility = SubResource("Curve_jo48k")
