[node name="Finish what was started" parent="AvailableQuests" unique_id=45835624 instance=ExtResource("2_7xuob")]
quest_id = 15
quest_name = "Finish what was started"
quest_description = "We are not the first to attack this being, though none ever succeeded. Along the streets are overgrown altars, part of a ritual intended to banish the curse once and for all. Though they never were used by those who erected them we can finish what was started. This complex Ritual involves moving between the altars while continuously channeling dark magic so strong barely any can even fathom it. The enemy knows this too so the area around the altars is sure to be riddled with traps. Spot them before they ever activate and be ready for whatever tricks may be thrown at you 
"
quest_neutral_outcome = "As the magic dissipates into the vast waters one must imagine that every single brick on these roads was but a trap. Being focused on a spell so incredibly complex leaves one invariably open and one single unfocused second spells the end. Can a plan this obvious ever be successful? 
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
is_final_quest = true
quest_group = 4

