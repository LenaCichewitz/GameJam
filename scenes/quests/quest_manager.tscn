[node name="Poseidon\'s Secrets" parent="AvailableQuests" unique_id=1605409417 instance=ExtResource("2_7xuob")]
quest_id = 10
quest_name = "Poseidon's Secrets"
quest_description = "Hidden behind a secret passage in one of Poseidon temples is said to lay a godly artifact of great power. Finding it however is only part of the trouble as one of the gods own creatures has taken to protecting it. Just laying eyes upon the beast tests one's mind and slaying it is a task not beneath a Hero. 
"
quest_success_outcome = "The god's power emanating from the statue feels almost smothering. This power is sure to be a great boon however the curse within rejects it outright. Caution is most important when mixing this holy and unholy power. 
"
quest_neutral_outcome = "Barely holding on to life, the thought of returning to face the beast again seems towering. Yet still this is the reality we are in. If this beast can not be felled the curse shall subsume us entirely. 
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 3
reward_item_id = 6

