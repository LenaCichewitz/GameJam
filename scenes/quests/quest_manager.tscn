[node name="A way forward" parent="AvailableQuests" unique_id=1178817276 instance=ExtResource("2_7xuob")]
quest_id = 12
quest_name = "A way forward"
quest_description = "A magical barrier separates the dark core from the rest of the city. To break it a ritual of dark nature is required. Only an expert in the dark ways may perform it and even then it will take some hours to complete. So stay on your toes, look out for any clue of danger and be ready to defend yourself
"
quest_success_outcome = "As the barrier lifts even greater horrors lie beyond. Do not be confused however, this is a great victory nonetheless and nothing but the result of immaculate work. Seeing such a work of great evil fall bolsters our strength against the curse, as we begin this final offence
"
quest_neutral_outcome = "It is simply too much, holding onto the ritual while defending ourselves against all manner of attacks. Still the barrier must fall and hoisting a new attack against it is inevitable. 
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
quest_group = 3
rewards_corruption_reduction = true
reward_corruption_reduction = -40.0

