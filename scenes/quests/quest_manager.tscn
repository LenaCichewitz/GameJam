[node name="A shot in the dark" parent="AvailableQuests" unique_id=1737277138 instance=ExtResource("2_7xuob")]
quest_id = 14
quest_name = "A shot in the dark"
quest_description = "The tunnels below the city will invariably lead to the core but where exactly one may emerge is impossible to know. Yet still attacking the enemy from an unexpected position is sure to create confusion in our favor. With no knowledge of what's to come, being able to make an adaptable plan on the fly and execute it swiftly is most important. The unthinkable horrors in these tunnels will surely oppose us as well 
"
quest_neutral_outcome = "No plan survives contact with the Enemy. Between winding paths, constant attacks and horrors whose pure existent proofs taxing its impossible to stay crafty. The sheer experience was overwhelming in a way nothing else has ever been. To go there again is pure madness…
"
quest_failure_outcome = "The curse takes hold of one of our own and they disappear into the depths, never to be seen again. This was expected, altho that only lightly eases the pain."
is_final_quest = true
quest_group = 4

